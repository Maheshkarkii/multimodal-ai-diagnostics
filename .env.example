# ==============================================================================
# AI Field Engineer - Environment Configuration Template (.env.example)
# Do NOT commit actual secrets or production keys to source control!
# ==============================================================================

# Server & Network Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_WORKERS=1
API_RELOAD=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# File Upload & Storage Limits
TEMP_UPLOAD_DIR=data/temp_uploads
MAX_IMAGE_SIZE_MB=15.0
MAX_AUDIO_SIZE_MB=25.0
REQUEST_TIMEOUT_SECONDS=60.0

# LLM & Reasoning Provider Configuration
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=YOUR_API_KEY_HERE

# Knowledge Base & Model Storage Paths
RAG_DOCUMENTS_DIR=data/rag/documents
VECTOR_STORE_DIR=data/rag/vector_store
MODEL_DIR=models
EXPLAINABILITY_OUTPUT_DIR=reports/explainability
AUDIT_LOG_DIR=reports/audit

# Build & CI Version Metadata
GIT_SHA=local-dev
LOG_LEVEL=INFO
